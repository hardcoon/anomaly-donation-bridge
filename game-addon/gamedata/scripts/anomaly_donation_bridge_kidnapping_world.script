-- ADB owns the camp assignment and captive AI. Moving the original ALife
-- object preserves the NPC's inventory, appearance and identity.
local function companions() return anomaly_donation_bridge_relife_companions end
local function named() return anomaly_donation_bridge_named_companion end
local CAPTIVE_LOGIC="scripts\\anomaly_donation_bridge_kidnapping.ltx"
local STANDALONE_LOGIC="scripts\\anomaly_donation_bridge_kidnapping_standalone.ltx"
local CAPTIVE_SECTION="adb_kidnapping_logic"
function server(id) return id and alife():object(id,true) end
function same(se,r)
    return se and r and se.id==r.id and se:name()==r.internal and se:section_name()==r.section
end
local function row(se) return {id=se.id,internal=se:name(),section=se:section_name()} end
local function point(se)
    return {x=se.position.x,y=se.position.y,z=se.position.z,lvid=se.m_level_vertex_id,gvid=se.m_game_vertex_id}
end
local function vec(p) return vector():set(p.x,p.y,p.z) end
local function teleport(id,p)
    alife():teleport_object(id,p.gvid,p.lvid,vec(p))
    -- motivator:net_destroy caches the OLD level vertex during switch_offline.
    -- Let net_spawn use the server's new point, including on another map.
    if db.offline_objects and db.offline_objects[id] then db.offline_objects[id].level_vertex_id=nil end
    if db.spawned_vertex_by_id then db.spawned_vertex_by_id[id]=nil end
end
local function map(gvid) return game_graph():vertex(gvid):level_id() end
local function save(se,k,v) se_save_var(se.id,se:name(),k,v) end
local function squad(r) local s=r and server(r.id);return same(s,r) and s or nil end
local function protect_squad(group,enabled)
    -- Some modpacks omit offline combat. When present, exclude only ADB's squads.
    local protected=sim_offline_combat and sim_offline_combat.task_squads
    if type(protected)=="table" then protected[group.id]=enabled and true or nil end
end

local function clear_legacy_hostage(r,victim)
    if r.world_migrated then return end
    local hostages=axr_task_manager and axr_task_manager.hostages_by_id
    -- Only an entry for the saved original captive at our own camp can be ours.
    if r.moved and type(hostages)=="table" and hostages[victim.id]==r.camp.id then hostages[victim.id]=nil end
end
function ui_free()
    if db.actor:is_talking() then return false end
    if actor_menu and type(actor_menu.is_hud_free)=="function" and not actor_menu.is_hud_free() then return false end
    if type(Check_UI)=="function" and Check_UI() then return false end
    if type(_GUIs)=="table" and next(_GUIs) then return false end
    if type(level.main_input_receiver)=="function" and level.main_input_receiver() then return false end
    return true
end
function available(alternative)
    local life=alife()
    return companions().available() and life and type(life.teleport_object)=="function" and xr_logic and
        type(xr_logic.configure_schemes)=="function" and type(xr_logic.activate_by_section)=="function" and
        modules and modules.stype_stalker and ini_file~=nil and
        utils_data and type(utils_data.CTime_to_table)=="function" and type(utils_data.CTime_from_table)=="function" and
        (alternative or axr_task_manager and axr_task_manager.hostages_by_id and
            dialogs and type(dialogs.rescue_hostage)=="function")
end
function choose_companion(excluded,alternative)
    local rows=companions().capture(excluded)
    local hostages=not alternative and axr_task_manager.hostages_by_id
    local here=map(db.actor:game_vertex_id())
    local candidates={}
    for _,r in ipairs(rows) do
        local s=server(r.id)
        local n=s and level.object_by_id(s.id)
        if n and s:name()==r.internal and s.m_game_vertex_id~=65535 and not (hostages and hostages[s.id]) and
            map(s.m_game_vertex_id)==here and type(n.invulnerable)=="function" then
            candidates[#candidates+1]=s.id
        end
    end
    if #candidates==0 then return nil end
    local s=server(candidates[math.random(#candidates)])
    local n=level.object_by_id(s.id)
    local r=row(s)
    r.group=s.group_id;r.origin=point(s);r.faction=s:community();r.nickname=n:character_name()
    r.invulnerable=n:invulnerable()
    local g=server(r.group);r.old_group=g and row(g) or nil
    r.registration=named().snapshot_registration(s)
    r.flags={}
    for _,k in ipairs({"companion","companion_cannot_dismiss","companion_cannot_teleport"}) do
        r.flags[k]=se_load_var(s.id,s:name(),k)
    end
    return r
end
-- Use navigable outdoor locations. Leave faction bases and locked camps alone.
local forbidden={l13_generators=true,l12_stancia_2=true,l12_stancia=true,l11_pripyat=true,l10_radar=true,
    l11_hospital=true,jupiter_underground=true,labx8=true,l03u_agr_underground=true,l04u_labx18=true,
    l08u_brainlab=true,l10u_bunker=true,l12u_control_monolith=true,l12u_sarcofag=true,l13u_warlab=true,fake_start=true}
function choose_camp(anywhere,used,captives,alternative)
    local free,occupied={},{}
    local blocked={}
    if not alternative then
        for npc,id in pairs(axr_task_manager.hostages_by_id) do
            if not captives[npc] then blocked[id]=true end
        end
    end
    local here=map(db.actor:game_vertex_id())
    local p=db.actor:position()
    local bases=simulation_objects and simulation_objects.base_smarts or {}
    for name,sm in pairs(SIMBOARD.smarts_by_names) do
        if SIMBOARD.smarts[sm.id] and not sm.locked and not bases[name] and not blocked[sm.id] and
            sm.m_level_vertex_id~=4294967295 and sm.m_game_vertex_id~=65535 then
            local mid=map(sm.m_game_vertex_id)
            local dx,dz=sm.position.x-p.x,sm.position.z-p.z
            if not forbidden[alife():level_name(mid)] and (anywhere or mid==here) and
                (mid~=here or dx*dx+dz*dz>=150*150) then
                local r=row(sm);r.point=point(sm);r.target=name
                local candidates=used[sm.id] and occupied or free
                candidates[#candidates+1]=r
            end
        end
    end
    local candidates=#free>0 and free or occupied
    table.sort(candidates,function(a,b) return a.id<b.id end)
    return #candidates>0 and candidates[math.random(#candidates)] or nil
end
local function keep_at_camp(group,r,captive)
    axr_companions.companion_squads[group.id]=nil
    if r.alternative_start then
        -- In GAMMA, the smart name uses the safe branch before the numeric lookup.
        group.scripted_target=r.camp.target or r.camp.internal
    elseif captive then
        group.scripted_target=nil -- ordinary hostage registry supplies this target
    else
        group.scripted_target=r.camp.id
    end
    protect_squad(group,true)
end
local function new_group(r,key,faction)
    local captive=key=="hostage_group"
    local existing=squad(r[key])
    if existing then keep_at_camp(existing,r,captive);return existing end
    assert(not r[key],"kidnap_squad_identity_changed")
    assert(same(SIMBOARD.smarts_by_names[r.camp.target or r.camp.internal],r.camp),"kidnap_camp_changed")
    local p=r.camp.point
    local g=assert(alife():create("online_offline_group",vec(p),p.lvid,p.gvid),"kidnap_squad_create_failed")
    r[key]=row(g) -- journal immediately; a save/load must reuse this group
    g.player_id=faction
    keep_at_camp(g,r,captive)
    SIMBOARD:assign_squad_to_smart(g,r.camp.id)
    return g
end
function stage_victim(r)
    local s=server(r.victim.id);assert(same(s,r.victim) and s:alive(),"kidnap_companion_missing")
    local g=new_group(r,"hostage_group",r.victim.faction)
    if s.group_id~=g.id then
        local smart=server(s.m_smart_terrain_id)
        if smart and type(smart.unregister_npc)=="function" then smart:unregister_npc(s) end
        companions().detach(s)
        named().release_following(s,false)
        g:register_member(s.id)
        SIMBOARD:setup_squad_and_group(s)
    end
    -- Captive is temporarily OUT of the actor's party. On a saved-game spawn,
    -- stock setup_companion_logic(loaded=true) hardcodes beh_companion.ltx;
    -- it cannot load our private beh@adb_kidnapped section. The ordinary
    -- initialize_obj path instead restores our saved INI/section correctly.
    save(s,"companion",nil);save(s,"companion_cannot_dismiss",true);save(s,"companion_cannot_teleport",true)
    if not r.alternative_start then axr_task_manager.hostages_by_id[s.id]=r.camp.id end
    if not r.moved then
        r.moved=true
        local p=r.camp.point
        -- teleport_object replaces the online object. Never access s/n after it.
        teleport(s.id,p)
    end
end
function spawn_guard(r,index)
    local g=new_group(r,"guard_group","arena_enemy")
    local old=r.guards[index]
    if old then return end -- never respawn a dead/missing guard after loading
    local section=r.plan[index]
    assert(anomaly_donation_bridge_catalog.is_spawn_safe(section,"npc"),"kidnap_guard_section_unsafe")
    local p=r.camp.point
    -- A smart's own vertex is valid on remote maps too. Online AI disperses
    -- members around its camp; no current-map vertex lookup for a remote map.
    local s=assert(alife():create(section,vec(p),p.lvid,p.gvid),"kidnap_guard_create_failed")
    r.guards[index]=row(s)
    g:register_member(s.id);SIMBOARD:setup_squad_and_group(s)
    s:force_set_goodwill(-5000,db.actor:id())
end
function guards_alive(r)
    for _,v in pairs(r.guards) do
        local s=server(v.id)
        if same(s,v) and s:alive() then return true end
    end
    return false
end
local function restore_flags(s,r)
    for _,k in ipairs({"companion_cannot_dismiss","companion_cannot_teleport"}) do save(s,k,r.victim.flags[k]) end
end
local function release_hostage(r)
    local s=server(r.victim.id)
    if same(s,r.victim) then
        if r.alternative_start then
            clear_legacy_hostage(r,s)
        else
            axr_task_manager.hostages_by_id[s.id]=nil
        end
        local n=level.object_by_id(s.id)
        if n then n:invulnerable(r.victim.invulnerable==true) end
        restore_flags(s,r)
        -- A corpse keeps the captive's saved INI. Do not route its next
        -- net_spawn through the stock companion loader with a private section.
        if not s:alive() then save(s,"companion",nil) end
    end
    local g=squad(r.hostage_group)
    if g then axr_companions.companion_squads[g.id]=nil;protect_squad(g,false) end
end
function restore_companion(r,rollback)
    local s=server(r.victim.id);assert(same(s,r.victim),"kidnap_companion_identity_changed")
    if not s:alive() then release_hostage(r);return end
    if rollback and r.moved and not r.return_moved then
        r.return_moved=true
        local p=r.victim.origin
        teleport(s.id,p)
        return false
    end
    local n=level.object_by_id(s.id)
    if n and not db.storage[s.id] then return false end
    -- Actual scheme/squad changes run only after the dialogue has closed.
    local captive_group=squad(r.hostage_group)
    if not r.alternative_start and n and captive_group and s.group_id==captive_group.id then
        dialogs.rescue_hostage(db.actor,n)
    end
    release_hostage(r)
    local group=squad(r.victim.old_group)
    if not group then
        if not r.return_group then
            local p=point(s)
            local g=assert(alife():create("online_offline_group",vec(p),p.lvid,p.gvid))
            r.return_group=row(g)
        end
        group=assert(squad(r.return_group),"kidnap_return_squad_missing")
    end
    if s.group_id~=group.id then
        local old=server(s.group_id)
        if old then old:unregister_member(s.id) end
        group:register_member(s.id);SIMBOARD:setup_squad_and_group(s)
    end
    group.player_id=r.victim.faction;group.scripted_target="actor"
    axr_companions.companion_squads[group.id]=group;axr_companions.non_task_companions[s.id]=true
    save(s,"companion",true)
    if n then
        if not r.victim.flags.companion_cannot_dismiss then n:disable_info_portion("npcx_beh_cannot_dismiss") end
        axr_companions.add_to_actor_squad(n);n:invulnerable(r.victim.invulnerable==true)
    end
    named().restore_registration(s,r.victim.registration)
    if captive_group and captive_group:npc_count()==0 then SIMBOARD:remove_squad(captive_group) end
    return true
end
function expire(r)
    local s=server(r.victim.id)
    if not same(s,r.victim) then release_hostage(r);return true end
    if not s:alive() then release_hostage(r);return true end
    local n=level.object_by_id(s.id)
    if n then n:invulnerable(false);n:kill(n) else s:kill() end
    release_hostage(r)
    return true
end
function finish_guards(r,discard)
    local g=squad(r.guard_group)
    if g then protect_squad(g,false) end
    if not discard then return end
    if g then g.scripted_target=nil end
    for _,v in pairs(r.guards) do
        local s=server(v.id)
        if same(s,v) then
            local smart=server(s.m_smart_terrain_id)
            if smart and type(smart.unregister_npc)=="function" then smart:unregister_npc(s) end
            if g and s.group_id==g.id then g:unregister_member(s.id) end
            if safe_release_manager and type(safe_release_manager.release)=="function" then
                safe_release_manager.release(s)
            else
                alife():release(s,true)
            end
        end
    end
    if g and g:npc_count()==0 then SIMBOARD:remove_squad(g) end
end
local function guard_relation(n)
    n:set_character_community("arena_enemy",0,0)
    game_relations.set_npcs_relation(n,db.actor,"enemy")
    n:force_set_goodwill(-5000,db.actor)
end
local function captive_logic(r,s,n)
    -- setup_companion_logic ALWAYS gives npcx_is_companion and activates the
    -- actor-following base. Never use it while the NPC is a captive.
    axr_companions.non_task_companions[s.id]=nil
    if se_load_var(s.id,s:name(),"companion") then save(s,"companion",nil) end
    if n:has_info("npcx_is_companion") then n:disable_info_portion("npcx_is_companion") end
    if n:has_info("npcx_beh_cannot_dismiss") then n:disable_info_portion("npcx_beh_cannot_dismiss") end
    local storage=assert(db.storage[s.id],"kidnap_npc_storage_unavailable")
    local path=r.alternative_start and STANDALONE_LOGIC or CAPTIVE_LOGIC
    if storage.ini_filename~=path or storage.section_logic~=CAPTIVE_SECTION or
        storage.active_section~="beh@adb_kidnapped" then
        local smart=server(s.m_smart_terrain_id)
        if smart and type(smart.unregister_npc)=="function" then smart:unregister_npc(s) end
        local ini=assert(ini_file(path),"kidnap_captive_ini_unavailable")
        n:inactualize_patrol_path()
        xr_logic.configure_schemes(n,ini,path,modules.stype_stalker,CAPTIVE_SECTION,"")
        xr_logic.activate_by_section(n,ini,"beh@adb_kidnapped","",false)
    end
end
function maintain(r,configured)
    local guard_group=squad(r.guard_group)
    if guard_group then
        guard_group.player_id="arena_enemy"
        keep_at_camp(guard_group,r)
    end
    local victim=server(r.victim.id)
    if same(victim,r.victim) and victim:alive() and r.moved then
        local g=squad(r.hostage_group)
        if g then keep_at_camp(g,r,true) end
        if not r.alternative_start then axr_task_manager.hostages_by_id[victim.id]=r.camp.id end
        if not r.captive_fixed_v2 or r.alternative_start and not r.world_migrated then
            if r.alternative_start then clear_legacy_hostage(r,victim) end
            local p=r.camp.point
            local dx,dz=victim.position.x-p.x,victim.position.z-p.z
            if r.phase=="captive" and (map(victim.m_game_vertex_id)~=map(p.gvid) or dx*dx+dz*dz>60*60) then
                if not ui_free() then return false end
                teleport(victim.id,p)
                r.captive_fixed_v2=true;r.world_migrated=r.alternative_start
                return false
            end
            r.captive_fixed_v2=true;r.world_migrated=r.alternative_start
        end
        local n=level.object_by_id(victim.id)
        if n then
            captive_logic(r,victim,n)
        end
    end
    for _,v in pairs(r.guards) do
        local s=server(v.id)
        if same(s,v) and s:alive() then
            local n=level.object_by_id(v.id)
            if n and not configured[v.id] then
                guard_relation(n)
                configured[v.id]=true
            end
        end
    end
    return true
end
function enemy_eval(r,object,enemy,flags)
    if not r or not object or not enemy or type(flags)~="table" then return end
    local id,eid=object:id(),enemy:id()
    if id==r.victim.id and same(server(id),r.victim) then
        flags.override=true;flags.result=false;return
    end
    for _,v in pairs(r.guards) do
        if id==v.id and same(server(id),v) then
            flags.override=true;flags.result=eid==db.actor:id();return
        end
    end
end
