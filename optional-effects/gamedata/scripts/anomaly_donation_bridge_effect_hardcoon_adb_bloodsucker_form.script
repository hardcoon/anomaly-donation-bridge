--[[ADB_PRESET_V1
{
  "schemaVersion": 1,
  "handlerId": "hardcoon.adb.bloodsucker_form",
  "displayName": "Превратиться в кровососа",
  "description": "Временно превращает героя в кровососа: свои HP, вид от третьего лица.\nУдары по очереди лечат 10% от максимального HP формы при попадании.\nПКМ — полупрозрачная невидимость для врагов; атаковать в ней нельзя.\nДвижение — прежний спринт; ускорение — ещё на 50% быстрее.\nEsc — вернуть героя с прежним HP. F5/F9 сохраняют форму до перезапуска игры.",
  "category": "metamorphosis",
  "cooldownSeconds": 3,
  "parameterDefinitions": [
    {
      "key": "mutant_sections",
      "displayName": "Внешность кровососа",
      "kind": "MultiChoice",
      "catalogKind": "Mutant",
