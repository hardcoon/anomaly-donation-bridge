      "displayName": "Длительность превращения, сек.",
      "kind": "Integer",
      "minimum": 1,
      "maximum": 60000,
      "defaultValue": "60"
    },
    {
      "key": "health_percent",
      "displayName": "Запас здоровья формы, %",
      "kind": "Integer",
      "minimum": 10,
      "maximum": 99999,
      "defaultValue": "200"
    },
    {
      "key": "attack_power_percent",
      "displayName": "Сила атаки, %",
      "kind": "Integer",
      "minimum": 10,
      "maximum": 9000,
      "defaultValue": "200"
    },
    {
      "key": "camera_mode",
      "displayName": "Положение камеры",
      "kind": "Choice",
      "options": [
        "side",
        "center"
      ],
      "optionLabels": {
        "side": "Камера сбоку",
        "center": "По центру"
      },
      "defaultValue": "side"
    },
    {
      "key": "melee_key",
      "displayName": "Удары с лечением (по умолчанию ЛКМ)",
      "kind": "GameInputKey",
      "defaultValue": "MOUSE_1"
    },
    {
      "key": "cloak_key",
      "displayName": "Невидимость вкл./выкл. (по умолчанию ПКМ)",
