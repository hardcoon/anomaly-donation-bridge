    {"key":"legacy_api","displayName":"Legacy api управление","kind":"Choice","options":["false","true"],"defaultValue":"false"},
    {"key":"duration_seconds","displayName":"Время работы, сек.","kind":"Integer","minimum":10,"maximum":99999999,"defaultValue":"60"},
    {"key":"follow_distance","displayName":"Расстояние следования, м","kind":"Integer","minimum":5,"maximum":100,"defaultValue":"20"},
    {"key":"extend_current","displayName":"Продлевать время текущего БТР","kind":"Choice","options":["false","true"],"defaultValue":"true"},
