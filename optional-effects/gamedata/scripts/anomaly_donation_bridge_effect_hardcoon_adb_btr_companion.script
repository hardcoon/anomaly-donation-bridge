ADB_PRESET_END]]

-- The template requests a spawn; the installed game module owns its lifetime.
local function ai() return anomaly_donation_bridge_btr_ai end
function passenger_object() return ai().passenger_object() end
function passenger_command(...) return ai().passenger_command(...) end
function spawn_anchor(...) return ai().spawn_anchor(...) end
-- Existing saves and generated vehicle sections retain these entry points.
function bind(object) return ai().bind(object) end
function before_hit(...) return ai().before_hit(...) end
local registered=false
function on_game_start()
    if registered then return end
    registered=true
    ai().on_game_start()
    anomaly_donation_bridge_registry.register("hardcoon.adb.btr_companion",{
        is_supported=function() return not not ai().supported(),"btr_native_api_unavailable" end,
        can_execute=function(...) return ai().can_execute(...) end,
        execute=function(...) return ai().execute(...) end})
end
