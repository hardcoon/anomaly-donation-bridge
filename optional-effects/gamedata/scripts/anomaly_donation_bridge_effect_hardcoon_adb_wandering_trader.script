function on_game_start()
    local impl=anomaly_donation_bridge_wandering_trader
    impl.start()
    anomaly_donation_bridge_registry.register_builtin("hardcoon.adb.wandering_trader",{
        can_execute=impl.can_execute,execute=impl.execute,update=impl.update,
        is_supported=impl.supported,support_probe_is_hint=true,
        on_game_load=impl.on_game_load,on_level_changing=impl.on_level_changing})
end
