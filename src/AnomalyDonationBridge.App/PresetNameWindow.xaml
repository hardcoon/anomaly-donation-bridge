<Window x:Class="AnomalyDonationBridge.App.PresetNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Text="Название пользовательского шаблона" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" />
        <StackPanel Grid.Row="1" Margin="0,14,0,18">
            <TextBox x:Name="NameBox" MaxLength="80" MinHeight="38" Padding="10,7" />
            <CheckBox x:Name="CopyUserPresetsBox"
                      Content="Перенести пользовательские шаблоны из текущего профиля"
                      IsChecked="True" Visibility="Collapsed" Margin="0,12,0,0" />
            <CheckBox x:Name="CopyVotingsBox" Content="Копировать голосования из текущего профиля"
                      IsChecked="True" Visibility="Collapsed" Margin="0,12,0,0" />
            <TextBlock x:Name="CopyVotingsHint" Text="Копии будут выключены, без голосов и результатов."
                       Visibility="Collapsed" Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" Margin="23,5,0,0" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource BadBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True" MinWidth="92" Padding="13,7" />
            <Button Content="Сохранить" IsDefault="True" Click="Save_Click" MinWidth="104" Margin="8,0,0,0" Padding="13,7"
                    Style="{StaticResource AccentOutlineButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
