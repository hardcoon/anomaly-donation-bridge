<Window x:Class="AnomalyDonationBridge.App.CatalogExclusionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить в исключения — Anomaly Donation Bridge"
        Width="760" Height="560" MinWidth="620" MinHeight="420"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Какие секции исключить?" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="В шаблоне было несколько игровых секций. Отметьте те, после которых возникла проблема."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <TextBox x:Name="SearchBox" Grid.Row="1" TextChanged="SearchBox_TextChanged"
                 ToolTip="Поиск по названию, ID, типу или категории" Margin="0,0,0,8" />
        <Border Grid.Row="2" Background="{DynamicResource ListWellBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="7">
            <DataGrid x:Name="CandidatesGrid" ItemsSource="{Binding RowsView}" IsReadOnly="True"
                      AutoGenerateColumns="False" BorderThickness="0" GridLinesVisibility="None"
                      Background="Transparent" AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="ВЫБРАТЬ" Width="78">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ТИП" Binding="{Binding KindLabel}" Width="115" />
                    <DataGridTextColumn Header="НАЗВАНИЕ" Binding="{Binding Entry.DisplayName}" Width="*" />
                    <DataGridTextColumn Header="ID СЕКЦИИ" Binding="{Binding Entry.SectionId}" Width="220" />
                    <DataGridTextColumn Header="КАТЕГОРИЯ" Binding="{Binding Entry.Category}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Исключение начнёт действовать сразу после добавления."
                       Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Отмена" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Добавить выбранные" Style="{StaticResource PrimaryButtonStyle}"
                    Click="Add_Click" MinWidth="150" />
        </Grid>
    </Grid>
</Window>
