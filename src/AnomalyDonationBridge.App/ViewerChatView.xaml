<UserControl x:Class="AnomalyDonationBridge.App.ViewerChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AnomalyDonationBridge.App"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="ChatLinkInputStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <Grid>
                                <!-- TextBox supplies its padding to the content host.
                                     Applying the same padding as a margin doubles the caret inset. -->
                                <ScrollViewer x:Name="PART_ContentHost"/>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}"
                                           Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChatExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Foreground="{DynamicResource TextBrush}"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          HorizontalContentAlignment="Stretch" BorderThickness="0" Padding="0" MinHeight="30">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="2" Padding="3,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <local:VectorIcon x:Name="Chevron" Glyph="&#xE76C;" Width="11" Height="11" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Glyph" Value="&#xE70D;"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Details" ContentSource="Content" Visibility="Collapsed" Margin="23,6,0,7"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12,6,8,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Click="Clear_Click" Style="{StaticResource GhostButtonStyle}" ToolTip="Очистить отображаемую ленту">
                    <StackPanel Orientation="Horizontal"><local:VectorIcon Glyph="&#xE894;" Width="13" Height="13" Margin="0,0,6,0"/><TextBlock Text="Очистить"/></StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="Чат зрителей" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Border x:Name="ConnectionsPanel" Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,10">
            <Expander x:Name="ConnectionsExpander" Header="Подключения" Style="{StaticResource ChatExpanderStyle}">
              <StackPanel>
                <StackPanel x:Name="ConnectionRows"/>
                <TextBlock Text="Публичные чаты читаются анонимно — аккаунт и свой API-ключ не нужны."
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Expander>
        </Border>
        <Grid Grid.Row="2">
            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                <ListBox x:Name="MessageList" BorderThickness="0" Padding="8,5" Background="Transparent"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.ScrollChanged="Messages_ScrollChanged" PreviewMouseWheel="Messages_PreviewMouseWheel"
                         AutomationProperties.Name="Общая лента чата зрителей">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Hint}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <local:ChatPlatformIcon Platform="{Binding Platform}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" LineHeight="20">
                                    <Run Text="{Binding Author, Mode=OneWay}" Foreground="{Binding NameBrush}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Text, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="25">
                <TextBlock Text="Здесь будут сообщения зрителей" FontSize="17" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="Подключите YouTube, Twitch или VK Видео Live." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="NewMessagesButton" Content="К новым сообщениям ↓" Click="NewMessages_Click"
                    Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12"
                    Style="{StaticResource AccentOutlineButtonStyle}"/>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,7,0,0">
            <TextBlock x:Name="FeedCount" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
            <TextBlock x:Name="ErrorHint" Foreground="{DynamicResource BadBrush}" Margin="12,0,0,0" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</UserControl>
