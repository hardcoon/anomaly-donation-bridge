<Window x:Class="AnomalyDonationBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AnomalyDonationBridge.App"
        xmlns:vm="clr-namespace:AnomalyDonationBridge.App.ViewModels"
        xmlns:core="clr-namespace:AnomalyDonationBridge.Core;assembly=AnomalyDonationBridge.Core"
        Title="Anomaly Donation Bridge"
        Width="1440" Height="860" MinWidth="640" MinHeight="520"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown" ContextMenuOpening="TemplateContextMenu_Opening">
    <Window.Resources>
        <Style x:Key="TraderStockSliderStyle" TargetType="Slider">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="1" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="SliderRoot" Background="Transparent">
                        <Border Height="4" Background="{DynamicResource BorderBrush}" CornerRadius="2" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                        <Border Height="4" Background="{DynamicResource AccentBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                    </ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="20" Cursor="SizeWE">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb">
                                        <Border x:Name="Grip" Background="{DynamicResource AccentBrush}" CornerRadius="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Grip" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                        </Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SliderRoot" Property="Opacity" Value="0.35" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="SearchEmptyTitleStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" />
            <Style.Triggers><DataTrigger Binding="{Binding HasTemplateSearchText}" Value="True"><Setter Property="Text" Value="Ничего не найдено" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SearchEmptyHintStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" />
            <Style.Triggers><DataTrigger Binding="{Binding HasTemplateSearchText}" Value="True"><Setter Property="Text" Value="Измените запрос, категорию или очистите поиск, чтобы сбросить фильтр." /></DataTrigger></Style.Triggers>
        </Style>
        <local:ParameterColumnWidthConverter x:Key="ParameterColumnWidth" />
        <Style x:Key="ThemeChoiceStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="Margin" Value="0,0,6,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="ChoiceSurface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ChoiceSurface" Property="Background" Value="{DynamicResource TriggerChipBrush}" />
                            <Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="ChoiceSurface" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="CategoryTabStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,3,0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                            <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource TriggerChipBrush}" />
                            <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="CategoryTabsTemplate">
            <ListBox ItemsSource="{x:Static vm:ActionBrowserViewModel.Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" SelectionChanged="CategoryTabs_SelectionChanged"
                     Background="Transparent" BorderThickness="0" Padding="0" FontSize="12"
                     ItemContainerStyle="{StaticResource CategoryTabStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Категории действий">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </DataTemplate>
        <DataTemplate x:Key="BrowserViewTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <CheckBox Content="Описание" VerticalAlignment="Center" Margin="0,0,14,0"
                          IsChecked="{Binding DataContext.ShowTemplateDescriptions, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                          ToolTip="Показывать описания и выбранные настройки карточек во всех разделах шаблонов" />
                <ComboBox Width="182" MinHeight="30" Padding="8,4"
                          ItemsSource="{x:Static vm:ActionBrowserViewModel.ViewOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedView, Mode=TwoWay}"
                          AutomationProperties.Name="Вид шаблонов" ToolTip="Компактный список или число колонок сетки" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PresetToolbarTemplate">
            <Grid Margin="0,0,8,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CategoryTabsTemplate}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource BrowserViewTemplate}" />
            </Grid>
        </DataTemplate>
        <Style x:Key="HistoryStatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Executed}"><Setter Property="Background" Value="{DynamicResource GoodDarkBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource GoodBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Rejected}"><Setter Property="Background" Value="{DynamicResource BadDarkBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource BadBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Uncertain}"><Setter Property="Background" Value="{DynamicResource BadDarkBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource BadBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Expired}"><Setter Property="Background" Value="{DynamicResource BadDarkBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource BadBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Skipped}"><Setter Property="Background" Value="{DynamicResource WarningPanelBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.NoRule}"><Setter Property="Background" Value="{DynamicResource WarningPanelBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Deferred}"><Setter Property="Background" Value="{DynamicResource WarningPanelBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Sent}"><Setter Property="Background" Value="{DynamicResource InfoPanelBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource BlueBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Queued}"><Setter Property="Background" Value="{DynamicResource InfoPanelBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource InfoTextBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <local:HistoryStatusMarkerConverter x:Key="HistoryStatusMarker" />


        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="ActionRowCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ActionRowEvenBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ActionRowBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="ClipToBounds" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActionExpanderHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactOrdinalBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TriggerChipBrush}" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="PriceGroupExpansionHintTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0">
                    <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Text" Value="&#xE76C;" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="Text" Value="&#xE70D;" />
                        </DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Развернуть" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="Text" Value="Скрыть" />
                        </DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="MainTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="16,10,16,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,5,0" Background="{TemplateBinding Background}">
                            <Border x:Name="SelectionLine" Height="2" CornerRadius="1"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Bottom" Visibility="Collapsed" />
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionLine" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                <Setter Property="Background" Value="{DynamicResource TriggerChipBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SelectionLine" Property="Background" Value="{DynamicResource BlueBrush}" />
                                <Setter TargetName="SelectionLine" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainHistoryHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
            <Setter Property="Padding" Value="9,7" />
        </Style>

        <Style x:Key="CatalogListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="CatalogListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CatalogItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CatalogItemBorder" Property="Background" Value="{DynamicResource ComboItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CatalogItemBorder" Property="Background" Value="{DynamicResource SelectionSurfaceBrush}" />
                                <Setter TargetName="CatalogItemBorder" Property="BorderBrush" Value="{DynamicResource BlueBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.62" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryQueueRemoveButtonStyle" TargetType="Button"
               BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="Content" Value="Удалить из очереди" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="5,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="ToolTip" Value="Отменить событие, пока оно ещё не передано игре" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReplaceOnFocusTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <EventSetter Event="GotKeyboardFocus" Handler="EditableTextBox_GotKeyboardFocus" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="EditableTextBox_PreviewMouseLeftButtonDown" />
        </Style>

        <DataTemplate x:Key="ParameterOptionTemplate">
            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextBrush}" />
        </DataTemplate>
        <DataTemplate x:Key="SpawnPointMethodOptionTemplate">
            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
        </DataTemplate>

        <DataTemplate x:Key="ParameterTemplate" DataType="{x:Type vm:ParameterValueViewModel}">
            <Grid Margin="0,0,10,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Top"
                           TextWrapping="Wrap"
                           FontSize="12" Margin="0,0,0,7" />
                <StackPanel Grid.Row="1">
                    <Grid>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource ReplaceOnFocusTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChoice, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKeyboardKey, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                                 PreviewKeyDown="GameKey_PreviewKeyDown" PreviewMouseDown="GameKey_PreviewMouseDown" ToolTip="{Binding GameKeyHint}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardKey}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <ComboBox ItemsSource="{Binding OptionEntries, Mode=OneWay}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="ItemTemplate" Value="{StaticResource ParameterOptionTemplate}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSpawnPointMethod, Mode=OneWay}" Value="True">
                                            <Setter Property="ItemTemplate" Value="{StaticResource SpawnPointMethodOptionTemplate}" />
                                            <Setter Property="Padding" Value="10,6,38,6" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFlatChoice, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Content="Включено"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBooleanChoice, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGroupedItemChoice, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Категория" Foreground="{DynamicResource SubtleBrush}"
                                           FontSize="11" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding Categories, Mode=OneWay}"
                                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource FriendlyValueConverter}}"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Предмет" Foreground="{DynamicResource SubtleBrush}"
                                           FontSize="11" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding FilteredOptionEntries, Mode=OneWay}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          MaxDropDownHeight="420"
                                          ScrollViewer.CanContentScroll="True"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}"
                                                       ToolTip="{Binding Value}" Foreground="{DynamicResource TextBrush}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding MultiChoiceOptions, Mode=OneWay}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWrappedMultiChoice, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MultiChoiceOptionViewModel}">
                                    <CheckBox Content="{Binding Label, Mode=OneWay}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{Binding Value, Mode=OneWay}"
                                              MinWidth="215" Margin="0,3,12,3"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding IsActiveTemplateSelection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ActiveTemplateSelectionHint}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding MultiChoiceOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,6">
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                        <Border Background="Transparent" BorderThickness="0" Padding="0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDynamicCatalogChoice, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CatalogSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Поиск в каталоге…" AutomationProperties.Name="Поиск в каталоге"
                                             ToolTip="Поиск по локализованному названию, section ID, группировке и силе" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding CatalogCategories, Mode=OneWay}"
                                              SelectedItem="{Binding SelectedCatalogCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding CatalogHint, Mode=OneWay}"
                                           Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,5,0,5" />

                                <ListBox Grid.Row="2" ItemsSource="{Binding CatalogOptionsView, Mode=OneWay}"
                                          SelectedItem="{Binding SelectedCatalogOption, Mode=TwoWay}"
                                          ItemContainerStyle="{StaticResource CatalogListBoxItemStyle}"
                                          MaxHeight="240" ScrollViewer.CanContentScroll="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource CatalogListBoxStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDynamicCatalogSingleChoice}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CatalogOptionViewModel}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LocalizedAndTechnicalName}"
                                                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Metadata}" Foreground="{DynamicResource SubtleBrush}"
                                                           FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <ListBox Grid.Row="3" ItemsSource="{Binding CatalogOptionsView, Mode=OneWay}"
                                         ItemContainerStyle="{StaticResource CatalogListBoxItemStyle}"
                                         MaxHeight="260" ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource CatalogListBoxStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDynamicCatalogMultiChoice}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CatalogOptionViewModel}">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsAvailable}" IsHitTestVisible="True">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding LocalizedAndTechnicalName}"
                                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Metadata}" Foreground="{DynamicResource SubtleBrush}"
                                                               FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,7,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDynamicCatalogMultiChoice}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding DisplayValue, Mode=OneWay}"
                                               Foreground="{DynamicResource SubtleBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <Button Content="Выделить всё"
                                            Command="{Binding SelectAllCatalogSelectionCommand}"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Снять все отметки"
                                            Command="{Binding ClearCatalogSelectionCommand}"
                                            Style="{StaticResource GhostButtonStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="5" Margin="0,7,0,0"
                                            Visibility="{Binding HasHiddenCatalogSelections, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding HiddenCatalogSummary, Mode=OneWay}"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,5" />
                                    <Button Content="Убрать скрытые секции"
                                            Command="{Binding RemoveHiddenCatalogSelectionsCommand}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding ValidationMessage, Mode=OneWay}"
                               Foreground="{DynamicResource BadBrush}"
                               FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SpawnPointMethodHint}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,0"
                               Visibility="{Binding IsSpawnPointMethod, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="При включённой паузе курсор неподвижен. Запуск и подтверждение результата — Пробел или назначенная клавиша прыжка."
                               Foreground="{DynamicResource MutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,7,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Definition.Key, Mode=OneWay}" Value="pause_game" />
                                            <Condition Binding="{Binding BooleanValue}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="PriceChipButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <DataTemplate x:Key="PriceConditionsTemplate">
            <StackPanel Margin="0,9,0,4">
                <ItemsControl ItemsSource="{Binding PriceItems}" ToolTip="Суммы доната: действие запускается при совпадении любого из условий." AutomationProperties.Name="Суммы доната">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type vm:TriggerRuleViewModel}">
                            <Border Background="{DynamicResource TriggerChipBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Label}" Style="{StaticResource PriceChipButtonStyle}"
                                            ToolTip="Изменить только это условие" AutomationProperties.Name="{Binding Label, StringFormat=Изменить условие {0}}"
                                            Command="{Binding DataContext.EditTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <Button Content="×" MinWidth="26" MinHeight="32" Padding="4,4" Style="{StaticResource GhostButtonStyle}"
                                            Foreground="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1,0,0,0"
                                            ToolTip="Удалить только это условие" AutomationProperties.Name="{Binding Label, StringFormat=Удалить условие {0}}"
                                            Command="{Binding DataContext.DeleteTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ActionViewModel}">
                            <Button local:ButtonVisual.Glyph="&#xE710;" local:ButtonVisual.Label="Сумма" Content="+ Сумма" MinHeight="34" Margin="0,0,6,6" Padding="10,5"
                                    Style="{StaticResource AccentOutlineButtonStyle}" BorderBrush="{DynamicResource WarningBorderBrush}"
                                    Command="{Binding DataContext.AddTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="CompactCatalogOptionTemplate" DataType="{x:Type vm:CatalogOptionViewModel}">
            <Border CornerRadius="2" Padding="3,1" Background="Transparent">
                <TextBlock Text="{Binding LocalizedAndTechnicalName}" ToolTip="{Binding Metadata}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
        <Style x:Key="CompactCatalogComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
            <Setter Property="ToolTip" Value="{Binding Metadata}" />
        </Style>
        <Style x:Key="CompactEditorComboBoxStyle" TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="34" />
        </Style>
        <Style x:Key="CompactEditorTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource ReplaceOnFocusTextBoxStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="CompactEditorSearchTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource CompactEditorTextBoxStyle}">
            <!-- Search is intentionally tighter than numeric inputs: its caret,
                 watermark and typed text share this single left inset. -->
            <Setter Property="Padding" Value="4,4" />
        </Style>
        <DataTemplate x:Key="ActionEditorTemplate">
            <StackPanel Margin="0,4,0,0">
                <StackPanel Visibility="{Binding IsItemBundle, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Предметы в одном срабатывании" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding ItemSpawnRows}">
                        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ItemSpawnRowViewModel}">
                            <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" MinWidth="163" /><ColumnDefinition Width="1.2*" MinWidth="125" />
                                        <ColumnDefinition Width="3*" MinWidth="260" /><ColumnDefinition Width="95" /><ColumnDefinition Width="82" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Категория" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Picker.CatalogCategories, Mode=OneWay}"
                                                  Style="{StaticResource CompactEditorComboBoxStyle}"
                                                  SelectedItem="{Binding Picker.SelectedCatalogCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Поиск" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Picker.CatalogSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CompactEditorSearchTextBoxStyle}"
                                                 Tag="Название или ID…" AutomationProperties.Name="Поиск в каталоге"
                                                 ToolTip="Фильтрует список по локализованному и техническому названию" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Picker.DisplayName}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Picker.CatalogOptionsView, Mode=OneWay}"
                                                  Style="{StaticResource CompactEditorComboBoxStyle}"
                                                  SelectedValuePath="SectionId"
                                                  SelectedValue="{Binding Picker.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemTemplate="{StaticResource CompactCatalogOptionTemplate}"
                                                  ItemContainerStyle="{StaticResource CompactCatalogComboItemStyle}"
                                                  IsTextSearchEnabled="False" MaxDropDownHeight="480"
                                                  ScrollViewer.CanContentScroll="True"
                                                  VirtualizingStackPanel.IsVirtualizing="True"
                                                  VirtualizingStackPanel.VirtualizationMode="Recycling" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                        <TextBlock Text="Количество" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactEditorTextBoxStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="4" Content="Удалить" Height="34" VerticalAlignment="Bottom"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding DataContext.RemoveItemSpawnCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding ValidationMessage}"
                                               Foreground="{DynamicResource BadBrush}" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ItemSpawnRows[0].Picker.CatalogHint, Mode=OneWay}"
                               Foreground="{DynamicResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7" />
                    <Button Content="+ Добавить предмет" HorizontalAlignment="Left" Padding="11,5" Margin="0,0,0,12"
                            Style="{StaticResource AccentOutlineButtonStyle}" Command="{Binding AddItemSpawnCommand}" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsSpawnGroupBundle, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Состав групп в одном срабатывании" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding SpawnGroupRows}">
                        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:SpawnGroupRowViewModel}">
                            <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" MinWidth="163" /><ColumnDefinition Width="1.1*" MinWidth="125" />
                                        <ColumnDefinition Width="2.2*" MinWidth="260" />
                                        <ColumnDefinition Width="90" /><ColumnDefinition Width="82" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Категория" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Picker.CatalogCategories, Mode=OneWay}"
                                                  Style="{StaticResource CompactEditorComboBoxStyle}"
                                                  SelectedItem="{Binding Picker.SelectedCatalogCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Поиск" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Picker.CatalogSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CompactEditorSearchTextBoxStyle}"
                                                 Tag="Название или ID…" AutomationProperties.Name="Поиск в каталоге"
                                                 ToolTip="Фильтрует список по названию, section ID, группировке и силе" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Picker.DisplayName}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Picker.CatalogOptionsView, Mode=OneWay}"
                                                  Style="{StaticResource CompactEditorComboBoxStyle}"
                                                  SelectedValuePath="SectionId"
                                                  SelectedValue="{Binding Picker.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemTemplate="{StaticResource CompactCatalogOptionTemplate}"
                                                  ItemContainerStyle="{StaticResource CompactCatalogComboItemStyle}"
                                                  IsTextSearchEnabled="False" MaxDropDownHeight="480"
                                                  ScrollViewer.CanContentScroll="True"
                                                  VirtualizingStackPanel.IsVirtualizing="True"
                                                  VirtualizingStackPanel.VirtualizationMode="Recycling" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                        <TextBlock Text="Количество" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactEditorTextBoxStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="4" Content="Удалить" Height="34" VerticalAlignment="Bottom"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding DataContext.RemoveSpawnGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding ValidationMessage}"
                                               Foreground="{DynamicResource BadBrush}" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding SpawnGroupRows[0].Picker.CatalogHint, Mode=OneWay}"
                               Foreground="{DynamicResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7" />
                    <Button Content="+ Добавить группу" HorizontalAlignment="Left" Padding="11,5" Margin="0,0,0,12"
                            Style="{StaticResource AccentOutlineButtonStyle}" Command="{Binding AddSpawnGroupCommand}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding RegularParameters}" ItemTemplate="{StaticResource ParameterTemplate}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                        <WrapPanel>
                            <WrapPanel.ItemWidth><MultiBinding Converter="{StaticResource ParameterColumnWidth}">
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                <Binding Path="DataContext.CompactParameterColumns" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                            </MultiBinding></WrapPanel.ItemWidth>
                        </WrapPanel>
                    </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,12,16"
                        Visibility="{Binding IsWanderingTrader, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Ассортимент" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding TraderStockRows}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled.BooleanValue, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Style="{StaticResource TraderStockSliderStyle}" Minimum="1" Maximum="{Binding Maximum}" Value="{Binding Count, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1"
                                            IsEnabled="{Binding Enabled.BooleanValue}" VerticalAlignment="Center" Margin="12,0,14,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding AbilityKeyParameters}" ItemTemplate="{StaticResource ParameterTemplate}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CooldownLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,7" />
                        <TextBox Text="{Binding CooldownText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ReplaceOnFocusTextBoxStyle}"
                                 Width="120" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding CooldownValidationMessage}" Foreground="{DynamicResource BadBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>

                </Grid>
                <TextBlock Text="{Binding CooldownHint}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding EditorUsageHint}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding IsPreset, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PdaActionCardContentTemplate" DataType="{x:Type vm:ActionViewModel}">
