                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                </DockPanel>
                <local:TemplateDescriptionTextBlock Description="{Binding Description}" HandlerId="{Binding HandlerId}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0"
                           Visibility="{Binding DataContext.ShowTemplateDescriptions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding OriginLabel}" Foreground="{DynamicResource BlueBrush}" FontSize="11" Margin="0,4,0,0">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding OriginLabel}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PriceConditionsTemplate}"
                                  Visibility="{Binding IsBuiltInPreset, Converter={StaticResource InverseBooleanConverter}}" />
                <ItemsControl ItemsSource="{Binding ParameterSummaryItems}"
                              Visibility="{Binding DataContext.ShowTemplateDescriptions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource InfoTextBrush}" TextWrapping="Wrap" Margin="0,0,12,3" />
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,9,0,0" Padding="0,8,0,0">
                    <local:CardToolbarPanel>
                        <Button local:ButtonVisual.Glyph="&#xE713;" Content="Настроить" Click="ConfigureAction_Click" Padding="6,5" AutomationProperties.Name="Настроить параметры шаблона" />
                        <Button local:ButtonVisual.Glyph="&#xE768;" Content="Тест" Padding="6,5"
                                Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                ToolTip="{Binding AvailabilityHint}" ToolTipService.ShowOnDisabled="True" IsEnabled="{Binding CanTest}"
                                Command="{Binding DataContext.TestCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        <Button local:ButtonVisual.Glyph="&#xE734;" Content="В пользовательские" Padding="6,5" Style="{StaticResource AccentOutlineButtonStyle}"
                                Visibility="{Binding IsBuiltInPreset, Converter={StaticResource BoolToVisibility}}" ToolTip="Сохранить настроенный вариант без цены в пользовательские шаблоны"
                                Command="{Binding DataContext.SaveAsUserPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
