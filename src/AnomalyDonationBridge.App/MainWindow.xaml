                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="2*" MinWidth="180" />
                                    <ColumnDefinition Width="3*" MinWidth="180" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CompactOrdinalBadgeStyle}">
                                    <TextBlock Text="{Binding DisplayOrdinalLabel}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <ContentPresenter Grid.Column="1" Content="{Binding}"
                                                  ContentTemplate="{StaticResource PriceGroupExpansionHintTemplate}" />
                                <Button Grid.Column="2" Width="28" Height="28" Padding="0" Focusable="False"
                                        Style="{StaticResource GhostButtonStyle}"
                                        AutomationProperties.Name="Переименовать группу"
                                        Command="{Binding DataContext.RenamePriceGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource MutedBrush}" />
                                </Button>
                                <TextBlock Grid.Column="3" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="6,0,12,0" ToolTip="{Binding CountLabel}" />
                                <ItemsControl Grid.Column="4" ItemsSource="{Binding SharedTriggers}" Margin="0,0,8,0"
                                              IsHitTestVisible="False" VerticalAlignment="Center"
                                              ToolTip="Общие суммы вложенных шаблонов">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><StaticResource ResourceKey="CompactPriceChipTemplate" /></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Button local:ButtonVisual.Glyph="&#xE710;" local:ButtonVisual.Label="Сумма" Grid.Column="1" Content="+ Сумма" Padding="10,4" MinWidth="82" Margin="0,0,6,0"
                                    Command="{Binding DataContext.AddPriceGroupTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button local:ButtonVisual.Glyph="&#xE768;" Grid.Column="2" Content="Тест" Padding="10,4" MinWidth="58"
                                    Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                    IsEnabled="{Binding CanTest}"
                                    ToolTip="Создать один тестовый донат с общей суммой и запустить все вложенные шаблоны"
                                    Command="{Binding DataContext.TestPriceGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                        <StackPanel Grid.Row="1" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel Margin="18,0,8,4">
                                <CheckBox Content="Выполнять строго по порядку" Margin="0,0,22,6" VerticalAlignment="Center" IsChecked="{Binding StrictSequence, Mode=OneWay}" Click="StrictSequence_Click"
                                          ToolTip="Ожидающий шаг не пропускает следующие шаги этой группы. Другие группы продолжают работу. Окончание длительного эффекта не ожидается." />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="Заменяет глобальную задержку между эффектами одного доната. 0 — без дополнительной паузы.">
                                    <TextBlock Text="Задержка между срабатываниями эффектов:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding GroupDelaySeconds, Mode=OneWay}" Width="64" Padding="7,4" VerticalContentAlignment="Center" MaxLength="5" LostKeyboardFocus="GroupDelay_LostKeyboardFocus" KeyDown="GroupDelay_KeyDown" AutomationProperties.Name="Задержка между срабатываниями эффектов" />
                                    <TextBlock Text="сек." VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Actions}" Margin="18,0,-1,9"
                                      ItemTemplate="{StaticResource SequenceCardTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                                <local:ActionCardPanel MinimumColumnWidth="380" MaximumColumns="5"
                                                       Columns="{Binding DataContext.ActiveBrowser.EffectiveColumns, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactActivePriceGroupRowTemplate" DataType="{x:Type vm:ActivePriceGroupViewModel}">
            <Border Style="{StaticResource ActionRowCardStyle}" Margin="0,0,0,2" MinHeight="38"
                    TextElement.Foreground="{DynamicResource TextBrush}">
                <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Margin="8,4,4,4" Background="Transparent" Cursor="Hand" Focusable="True"
                              MouseLeftButtonUp="PriceGroupHeader_MouseLeftButtonUp"
                              KeyDown="PriceGroupHeader_KeyDown"
                              AutomationProperties.Name="Развернуть или скрыть группу шаблонов">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="2*" MinWidth="100" /><ColumnDefinition Width="2*" MinWidth="80" /><ColumnDefinition Width="2*" MinWidth="150" MaxWidth="360" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CompactOrdinalBadgeStyle}">
                                <TextBlock Text="{Binding DisplayOrdinalLabel}" FontFamily="Consolas" FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <Grid Grid.Column="1" Margin="0,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="102" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{Binding}"
                                                  ContentTemplate="{StaticResource PriceGroupExpansionHintTemplate}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="{Binding CountLabel}" />
                            </Grid>
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding SharedTriggers}" Margin="0,0,8,0"
                                          IsHitTestVisible="False" VerticalAlignment="Center"
                                          ToolTip="Общие суммы вложенных шаблонов">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><StaticResource ResourceKey="CompactPriceChipTemplate" /></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <local:CardToolbarPanel Grid.Column="3" VerticalAlignment="Center"><Button local:ButtonVisual.Glyph="&#xE710;" local:ButtonVisual.Label="Сумма" Content="+ Сумма" Padding="6,4"
                                    Command="{Binding DataContext.AddPriceGroupTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button local:ButtonVisual.Glyph="&#xE768;" Content="Тест" Padding="6,4"
                                    Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                    IsEnabled="{Binding CanTest}"
                                    ToolTip="Создать один тестовый донат с общей суммой и запустить все вложенные шаблоны"
                                    Command="{Binding DataContext.TestPriceGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button Width="32" Height="28" Padding="0" Focusable="False"
                                    Style="{StaticResource GhostButtonStyle}"
                                    AutomationProperties.Name="Переименовать группу"
                                    ToolTip="Переименовать группу"
                                    Command="{Binding DataContext.RenamePriceGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </Button></local:CardToolbarPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel Margin="18,0,8,4">
                                <CheckBox Content="Выполнять строго по порядку" Margin="0,0,22,6" VerticalAlignment="Center" IsChecked="{Binding StrictSequence, Mode=OneWay}" Click="StrictSequence_Click"
                                          ToolTip="Ожидающий шаг не пропускает следующие шаги этой группы. Другие группы продолжают работу. Окончание длительного эффекта не ожидается." />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="Заменяет глобальную задержку между эффектами одного доната. 0 — без дополнительной паузы.">
                                    <TextBlock Text="Задержка между срабатываниями эффектов:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding GroupDelaySeconds, Mode=OneWay}" Width="64" Padding="7,4" VerticalContentAlignment="Center" MaxLength="5" LostKeyboardFocus="GroupDelay_LostKeyboardFocus" KeyDown="GroupDelay_KeyDown" AutomationProperties.Name="Задержка между срабатываниями эффектов" />
                                    <TextBlock Text="сек." VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding Actions}" Margin="18,1,-1,4" ItemTemplate="{StaticResource CompactSequenceTemplate}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ActiveActionListEntryTemplate" DataType="{x:Type vm:ActiveActionListEntryViewModel}">
            <ContentControl>
                <ContentControl.Style><Style TargetType="ContentControl">
                    <Setter Property="Content" Value="{Binding Action}" />
                    <Setter Property="ContentTemplate" Value="{StaticResource ActiveActionCardTemplateV2}" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsGroup}" Value="True">
                        <Setter Property="Content" Value="{Binding Group}" />
                        <Setter Property="ContentTemplate" Value="{StaticResource ActivePriceGroupCardTemplate}" />
                    </DataTrigger></Style.Triggers>
                </Style></ContentControl.Style>
            </ContentControl>
        </DataTemplate>
        <DataTemplate x:Key="CompactActiveActionListEntryTemplate" DataType="{x:Type vm:ActiveActionListEntryViewModel}">
            <ContentControl>
                <ContentControl.Style><Style TargetType="ContentControl">
                    <Setter Property="Content" Value="{Binding Action}" />
                    <Setter Property="ContentTemplate" Value="{StaticResource CompactActiveActionRowTemplate}" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsGroup}" Value="True">
                        <Setter Property="Content" Value="{Binding Group}" />
                        <Setter Property="ContentTemplate" Value="{StaticResource CompactActivePriceGroupRowTemplate}" />
                    </DataTrigger></Style.Triggers>
                </Style></ContentControl.Style>
            </ContentControl>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <Grid x:Name="WideShell" Background="{DynamicResource BackgroundBrush}" Margin="26,18,26,16"
          Visibility="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="ApplicationLogo" Width="44" Height="44" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ANOMALY DONATION BRIDGE" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Интерактивные события для стрима" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="HeaderBridgeUpdateButton" Grid.Column="1"
                    Content="{Binding BridgeUpdateButtonText}" Command="{Binding InstallBridgeCommand}"
                    Visibility="{Binding ShowBridgeUpdate, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource AccentOutlineButtonStyle}"
                    ToolTip="{Binding BridgeUpdateHint}" Padding="16,8" Margin="12,0"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            <local:CardToolbarPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="480" HorizontalAlignment="Right">
                <Button x:Name="ThemeButton" Content="Тема" local:ButtonVisual.Glyph="&#xE790;" Click="ThemePicker_Click" Padding="9,8" ToolTip="Цвет оформления и чёрный или белый фон" AutomationProperties.Name="Тема приложения" />

                <Button local:ButtonVisual.Glyph="&#xEB05;" Content="Голосования" Click="Voting_Click"
                        Padding="9,8" VerticalAlignment="Center" />
                <Button local:ButtonVisual.Glyph="&#xE716;" Content="Профили" Click="Profiles_Click"
                        Padding="9,8" VerticalAlignment="Center" />
                <Button local:ButtonVisual.Glyph="&#xE713;" Content="Настройки" Click="Settings_Click"
                        Padding="9,8" VerticalAlignment="Center" />
            </local:CardToolbarPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource StatusCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}" Margin="0,3,12,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ИНТЕГРАЦИИ" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{Binding DonationStatus, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatusCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource BlueBrush}" Margin="0,3,12,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ИГРА" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{Binding GameStatus, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding CatalogStatus, Mode=OneWay}" ToolTip="{Binding CatalogStatus}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding ExtensionStatus, Mode=OneWay}" ToolTip="{Binding ExtensionStatus}" Foreground="{DynamicResource SubtleBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding CatalogProgressPercent, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsCatalogProgressIndeterminate, Mode=OneWay}"
                                     Visibility="{Binding IsCatalogSynchronizing, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding CatalogProgressText, Mode=OneWay}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"
                                   Visibility="{Binding IsCatalogSynchronizing, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="↻" Command="{Binding RefreshCatalogCommand}"
                            IsEnabled="{Binding CanRefreshCatalog, Mode=OneWay}"
                            Width="32" Height="32" Padding="0" Margin="10,0,0,0"
                            VerticalAlignment="Top" FontSize="19" FontWeight="SemiBold"
                            Style="{StaticResource GhostButtonStyle}"
                            ToolTip="Обновить каталог игры вручную"
                            AutomationProperties.Name="Обновить каталог игры" />
                </Grid>
            </Border>

            <Border Grid.Column="4">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatusCardStyle}">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Armed}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TriggerChipBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="ОБРАБОТКА ДОНАТОВ" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{Binding ProcessingStatus}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Armed, Mode=TwoWay}"
                              IsEnabled="{Binding CanArm, Mode=OneWay}"
                              Style="{StaticResource SwitchCheckBoxStyle}"
                              ToolTip="{Binding ArmHint, Mode=OneWay}"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
        <TabControl x:Name="MainSections" SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}"
                    BorderThickness="0" Padding="0" Margin="0,0,0,12"
                    Background="Transparent">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid x:Name="SectionHeader" Margin="0,0,0,1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <WrapPanel IsItemsHost="True" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,5,10,0">
                                <Border x:Name="TemplateSearchSurface" Height="34" VerticalAlignment="Top"
                                        Background="{DynamicResource InputBrush}" BorderThickness="1" CornerRadius="3"
                                        Visibility="{Binding ShowTemplateSearch, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Style><Style TargetType="Border">
                                        <Setter Property="Width" Value="270" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                                            <DataTrigger Binding="{Binding HasTemplateSearchText}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style></Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button x:Name="TemplateSearchButton" Width="32" Height="32" MinHeight="0" Padding="0"
                                                Style="{StaticResource GhostButtonStyle}" Click="TemplateSearch_Click"
                                                ToolTip="Поиск шаблонов · Ctrl+F"
                                                AutomationProperties.Name="Перейти к поиску шаблонов">
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                        </Button>
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="TemplateSearchTextBox" Text="{Binding TemplateSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="160" Padding="2,4" BorderThickness="0" Background="Transparent"
                                                     MinWidth="0" MinHeight="0" VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="Поиск по названию шаблона" />
                                            <TextBlock Text="{Binding TemplateSearchHint}" Foreground="{DynamicResource MutedBrush}"
                                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="4,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style><Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding TemplateSearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Button x:Name="ClearTemplateSearchButton" Grid.Column="2" Width="30" Height="32" MinHeight="0" Padding="0"
                                                Style="{StaticResource GhostButtonStyle}" Click="ClearTemplateSearch_Click"
                                                IsEnabled="{Binding HasTemplateSearchText}"
                                                ToolTip="Очистить поиск · Esc" AutomationProperties.Name="Очистить поиск и сбросить фильтр">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border x:Name="QueueStatusSurface" Margin="10,0,0,0" Height="34" MaxWidth="270"
                                        Background="{DynamicResource TriggerChipBrush}" BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,5"
                                        Visibility="{Binding HasQueueStatus, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding QueueStatusText}">
                                    <TextBlock Text="{Binding QueueStatusText}" Foreground="{DynamicResource AccentForegroundBrush}"
                                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Style="{StaticResource MainTabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                        <TextBlock Text="Активные" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" FontWeight="SemiBold" />
                        <Border Background="{DynamicResource CountBadgeBrush}" CornerRadius="3" Padding="7,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding ActiveActions.Count, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontSize="10" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="Transparent" BorderThickness="0" Padding="0" TextElement.Foreground="{DynamicResource TextBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,8,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{Binding ActiveBrowser}" ContentTemplate="{StaticResource CategoryTabsTemplate}" HorizontalAlignment="Left" />
                            <Button Grid.Column="1" Content="Экспорт для стрима…"
                                    HorizontalAlignment="Right" MinHeight="30" Padding="11,4" Margin="0,0,8,0"
                                    Style="{StaticResource GhostButtonStyle}"
                                    ToolTip="Сохранить TXT: порядковый номер, название и все назначенные цены в текущем порядке"
                                    Command="{Binding ExportActivePresetsCommand}" />
                            <Button Grid.Column="2" Content="Сортировка ▾"
                                    HorizontalAlignment="Right" MinHeight="30" Padding="11,4"
                                    Style="{StaticResource GhostButtonStyle}" Click="CardMenu_Click"
                                    ToolTip="Сортировать по минимальной назначенной сумме; валюты сравниваются как числа без конвертации">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom" VerticalOffset="6">
                                        <MenuItem Header="По возрастанию цены"
                                                  Command="{Binding PlacementTarget.DataContext.SortActiveByPriceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="ascending" />
                                        <MenuItem Header="По убыванию цены"
                                                  Command="{Binding PlacementTarget.DataContext.SortActiveByPriceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="descending" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <ContentPresenter Grid.Column="3" Content="{Binding ActiveBrowser}" ContentTemplate="{StaticResource BrowserViewTemplate}" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ActiveActionsList" ItemsSource="{Binding ActiveBrowser.VisibleEntries, Mode=OneWay}"
                                          HorizontalAlignment="Stretch" Margin="0,4,10,6" AlternationCount="2">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="ItemTemplate" Value="{StaticResource ActiveActionListEntryTemplate}" />
                                        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate>
                                            <local:ActionCardPanel MinimumColumnWidth="380" MaximumColumns="5" Columns="{Binding ActiveBrowser.EffectiveColumns}" />
                                        </ItemsPanelTemplate></Setter.Value></Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveBrowser.CompactMode}" Value="True">
                                                <Setter Property="ItemTemplate" Value="{StaticResource CompactActiveActionListEntryTemplate}" />
                                                <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=ActiveActionsList, Path=HasItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource PanelBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock Text="0" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="20" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Tag="В этой категории нет активных вариантов" Style="{StaticResource SearchEmptyTitleStyle}" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Tag="Выберите «Все» или добавьте вариант из раздела «Шаблоны»." Style="{StaticResource SearchEmptyHintStyle}"
                                       Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Style="{StaticResource MainTabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                        <TextBlock Text="Пользовательские шаблоны" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" FontWeight="SemiBold" />
                        <Border Background="{DynamicResource CountBadgeBrush}" CornerRadius="3" Padding="7,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding UserPresets.Count, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontSize="10" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="Transparent" BorderThickness="0" Padding="0" TextElement.Foreground="{DynamicResource TextBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,8,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ContentPresenter Content="{Binding UserPresetBrowser}" ContentTemplate="{StaticResource CategoryTabsTemplate}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" Content="{Binding UserPresetBrowser}" ContentTemplate="{StaticResource BrowserViewTemplate}" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="UserPresetsList" ItemsSource="{Binding UserPresetBrowser.VisibleActions, Mode=OneWay}"
                                          HorizontalAlignment="Stretch" Margin="0,4,10,6" AlternationCount="2">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="ItemTemplate" Value="{StaticResource PresetCardTemplateV2}" />
                                        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate>
                                            <local:ActionCardPanel MinimumColumnWidth="380" MaximumColumns="5" Columns="{Binding UserPresetBrowser.EffectiveColumns}" />
                                        </ItemsPanelTemplate></Setter.Value></Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UserPresetBrowser.CompactMode}" Value="True">
                                                <Setter Property="ItemTemplate" Value="{StaticResource CompactUserPresetRowTemplate}" />
                                                <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                            <StackPanel.Style><Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding ElementName=UserPresetsList, Path=HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger></Style.Triggers>
                            </Style></StackPanel.Style>
                            <TextBlock Tag="Пользовательских шаблонов пока нет" Style="{StaticResource SearchEmptyTitleStyle}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Tag="Настройте коробочный шаблон и нажмите «В пользовательские». Сумму назначьте уже здесь перед активацией." Style="{StaticResource SearchEmptyHintStyle}"
                                       Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Style="{StaticResource MainTabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                        <TextBlock Text="Шаблоны" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" FontWeight="SemiBold" />
                        <Border Background="{DynamicResource CountBadgeBrush}" CornerRadius="3" Padding="7,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Presets.Count, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontSize="10" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="Transparent" BorderThickness="0" Padding="0" TextElement.Foreground="{DynamicResource TextBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <ContentPresenter Content="{Binding PresetBrowser}" ContentTemplate="{StaticResource PresetToolbarTemplate}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PresetsList" ItemsSource="{Binding PresetBrowser.VisibleActions, Mode=OneWay}"
                                          HorizontalAlignment="Stretch" Margin="0,4,10,6" AlternationCount="2">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="ItemTemplate" Value="{StaticResource PresetCardTemplateV2}" />
                                        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate>
                                            <local:ActionCardPanel MinimumColumnWidth="380" MaximumColumns="5" Columns="{Binding PresetBrowser.EffectiveColumns}" />
                                        </ItemsPanelTemplate></Setter.Value></Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PresetBrowser.CompactMode}" Value="True">
                                                <Setter Property="ItemTemplate" Value="{StaticResource CompactBuiltInPresetRowTemplate}" />
                                                <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=PresetsList, Path=HasItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Tag="В этой категории нет шаблонов" Style="{StaticResource SearchEmptyTitleStyle}" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Tag="Выберите вкладку «Все», чтобы увидеть доступные шаблоны." Style="{StaticResource SearchEmptyHintStyle}"
                                       Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Style="{StaticResource MainTabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                        <TextBlock Text="История" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" FontWeight="SemiBold" />
                        <Border Background="{DynamicResource CountBadgeBrush}" CornerRadius="3" Padding="7,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding History.Count, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontSize="10" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="{DynamicResource ListWellBrush}" BorderThickness="0" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Background="{DynamicResource ListWellBrush}" MinHeight="45">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="13,0" VerticalAlignment="Center">
                                <TextBlock Text="История событий" Style="{StaticResource SectionTitleStyle}" FontSize="15" />
                                <TextBlock Text="  •  последние 500 записей" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,8,6">
                                <Button Content="Повторить" Command="{Binding RetryCommand}"
                                        Style="{StaticResource AccentOutlineButtonStyle}" Padding="12,4"
                                        ToolTip="Повтор доступен только для безопасных завершённых событий" />
                                <Button Content="Применить мгновенно" Command="{Binding ApplyQueuedImmediatelyCommand}"
                                        Style="{StaticResource AccentOutlineButtonStyle}" Margin="8,0,0,0" Padding="12,4"
                                        ToolTip="Только выделенные события в очереди. Пропускает порядок и паузы; проверки готовности игры сохраняются." />
                                <Button Content="В исключения" Command="{Binding AddHistoryExclusionCommand}"
                                        Style="{StaticResource AccentOutlineButtonStyle}"
                                        Margin="8,0,0,0" Padding="12,4"
                                        ToolTip="Исключить выбранные в этой записи игровые секции из ручного и случайного выбора" />
                                <Button Content="{Binding RefreshEventsButtonText}"
                                        Command="{Binding RefreshEventsCommand}"
                                        Style="{StaticResource AccentOutlineButtonStyle}"
                                        Margin="8,0,0,0" Padding="12,4"
                                        ToolTip="Переподключиться к игре и повторно запросить ответы на зависшие команды без повторного выполнения эффекта" />
                                <Button Content="Очистить очередь" Command="{Binding ClearQueueCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Margin="8,0,0,0" Padding="12,4"
                                        ToolTip="Удалить все эффекты, которые ещё не были переданы игре" />
                            </WrapPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding History, Mode=OneWay}"
                                      SelectionMode="Extended" SelectionUnit="FullRow" local:HistoryListBehavior.IsEnabled="True"
                                      IsReadOnly="True" AlternationCount="2" BorderThickness="0"
                                      Background="Transparent" GridLinesVisibility="None"
                                      ColumnHeaderStyle="{StaticResource MainHistoryHeaderStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ВРЕМЯ" Binding="{Binding DonationCreatedAt, StringFormat=dd.MM HH:mm:ss}" Width="112" />
                                    <DataGridTextColumn Header="ДОНАТЕР" Binding="{Binding DisplayDonor}" Width="125" />
                                    <DataGridTextColumn Header="СУММА" Binding="{Binding Amount}" Width="80" />
                                    <DataGridTextColumn Header="ВАЛЮТА" Binding="{Binding Currency}" Width="70" />
                                    <DataGridTextColumn Header="ДЕЙСТВИЕ" Binding="{Binding ActionName}" Width="175" />
                                    <DataGridTemplateColumn Header="СТАТУС" Width="166">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <Border Style="{StaticResource HistoryStatusBadgeStyle}" HorizontalAlignment="Left" ToolTip="{Binding Detail}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding State, Converter={StaticResource HistoryStatusMarker}}" FontWeight="Bold" Width="18" />
                                                    <TextBlock Text="{Binding State, Converter={StaticResource FriendlyValueConverter}}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="ПОДРОБНОСТИ" Binding="{Binding Detail}" Width="*" />
                                    <DataGridTemplateColumn Header="" Width="138">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource HistoryQueueRemoveButtonStyle}"
                                                        Command="{Binding DataContext.RemoveQueuedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=HistoryGrid, Path=HasItems}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Событий пока не было" Foreground="{DynamicResource MutedBrush}"
                                           FontSize="14" HorizontalAlignment="Center" />
                                <TextBlock Text="Тесты эффектов и обработанные донаты появятся здесь."
                                           Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
        </Grid>

        <Grid Grid.Row="3" Margin="2,8,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Notice, Mode=OneWay}" Foreground="{DynamicResource AccentForegroundBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding DataDirectory, Mode=OneWay}"
                       Foreground="{DynamicResource SubtleBrush}" FontSize="10"
                       TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center" />
        </Grid>
    </Grid>
    <local:CompactMainView x:Name="CompactShell" Visibility="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
        <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=ThemeButton}"
               Placement="Bottom" VerticalOffset="7" StaysOpen="False" AllowsTransparency="True"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
               Opened="ThemePopup_Opened">
            <Border x:Name="ThemePopupSurface" Width="284" Padding="16"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1" CornerRadius="5"
                    TextElement.Foreground="{DynamicResource TextBrush}" TextElement.FontFamily="Segoe UI"
                    TextElement.FontSize="13"
                    KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="ThemePopup_PreviewKeyDown">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button Content="×" Click="CloseThemePopup_Click" DockPanel.Dock="Right"
                                Style="{StaticResource GhostButtonStyle}" Padding="5,0" FontSize="18"
                                AutomationProperties.Name="Закрыть выбор темы" />
                        <TextBlock Text="Оформление" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel x:Name="ThemeChoices">
                        <TextBlock Text="Цвет" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,7" />
                        <UniformGrid Columns="2" Margin="0,0,-6,7">
                            <RadioButton x:Name="ThemeRedChoice" GroupName="ApplicationThemeColor" Tag="red"
                                         Style="{StaticResource ThemeChoiceStyle}" Checked="ThemeColor_Checked"
                                         IsChecked="{Binding IsRedTheme, Mode=OneWay}" AutomationProperties.Name="Красный цвет">
                                <StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Fill="#C89E98" Margin="0,0,8,0" /><TextBlock Text="Красный" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ThemeGreenChoice" GroupName="ApplicationThemeColor" Tag="green"
                                         Style="{StaticResource ThemeChoiceStyle}" Checked="ThemeColor_Checked"
                                         IsChecked="{Binding IsGreenTheme, Mode=OneWay}" AutomationProperties.Name="Зелёный цвет">
                                <StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Fill="#A4B59C" Margin="0,0,8,0" /><TextBlock Text="Зелёный" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ThemeBlueChoice" GroupName="ApplicationThemeColor" Tag="blue"
                                         Style="{StaticResource ThemeChoiceStyle}" Checked="ThemeColor_Checked"
                                         IsChecked="{Binding IsBlueTheme, Mode=OneWay}" AutomationProperties.Name="Синий цвет">
                                <StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Fill="#9EAFC6" Margin="0,0,8,0" /><TextBlock Text="Синий" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ThemeYellowChoice" GroupName="ApplicationThemeColor" Tag="yellow"
                                         Style="{StaticResource ThemeChoiceStyle}" Checked="ThemeColor_Checked"
                                         IsChecked="{Binding IsYellowTheme, Mode=OneWay}" AutomationProperties.Name="Жёлтый цвет">
                                <StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Fill="#D6B25F" Margin="0,0,8,0" /><TextBlock Text="Жёлтый" /></StackPanel>
                            </RadioButton>
                        </UniformGrid>
                        <TextBlock Text="Фон" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,7" />
                        <UniformGrid Columns="2" Margin="0,0,-6,0">
                            <RadioButton x:Name="ThemeBlackChoice" Content="Чёрный" GroupName="ApplicationThemeBackground" Tag="black"
                                         Style="{StaticResource ThemeChoiceStyle}" Checked="ThemeBackground_Checked"
                                         IsChecked="{Binding IsBlackTheme, Mode=OneWay}" />
                            <RadioButton x:Name="ThemeWhiteChoice" Content="Белый" GroupName="ApplicationThemeBackground" Tag="white"
                                         Style="{StaticResource ThemeChoiceStyle}" Checked="ThemeBackground_Checked"
                                         IsChecked="{Binding IsLightTheme, Mode=OneWay}" />
                        </UniformGrid>
                    </StackPanel>
                    <TextBlock x:Name="ThemePopupError" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{DynamicResource BadBrush}" Margin="0,7,0,0" />
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0">
                        <Button Content="Готово" Click="CloseThemePopup_Click" HorizontalAlignment="Right"
                                Style="{StaticResource AccentOutlineButtonStyle}" Padding="12,6" />
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
