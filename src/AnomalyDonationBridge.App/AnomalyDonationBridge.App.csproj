    <Content Include="..\..\game-addon\gamedata\configs\ui\textures_descr\anomaly_donation_bridge_burer_form.xml"
             Link="addon-package\gamedata\configs\ui\textures_descr\anomaly_donation_bridge_burer_form.xml"
