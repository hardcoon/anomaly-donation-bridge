    <Content Include="..\..\game-addon\gamedata\textures\ui\anomaly_donation_bridge_mutant_v2.dds"
             Link="addon-package\gamedata\textures\ui\anomaly_donation_bridge_mutant_v2.dds"
             ExcludeFromSingleFile="true"
