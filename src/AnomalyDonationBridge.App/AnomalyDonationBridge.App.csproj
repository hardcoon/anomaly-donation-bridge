    <Content Include="..\..\game-addon\gamedata\textures\ui\anomaly_donation_bridge_burer_form.dds"
             Link="addon-package\gamedata\textures\ui\anomaly_donation_bridge_burer_form.dds"
             ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\effects\gamedata\scripts\*.script"
             Link="effects\gamedata\scripts\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\optional-effects\gamedata\scripts\*.script"
             Link="effects\gamedata\scripts\%(Filename)%(Extension)"
