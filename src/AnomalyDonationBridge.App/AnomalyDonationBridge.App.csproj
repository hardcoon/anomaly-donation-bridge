<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>AnomalyDonationBridge.App.Program</StartupObject>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AnomalyDonationBridge</AssemblyName>
    <RootNamespace>AnomalyDonationBridge.App</RootNamespace>
    <AssemblyTitle>Anomaly Donation Bridge</AssemblyTitle>
    <Product>Anomaly Donation Bridge</Product>
    <Description>Donation service bridge for S.T.A.L.K.E.R. Anomaly</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AnomalyDonationBridge.ico</ApplicationIcon>
    <Version>1.4.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\third-party\youtube\*" Link="_internal\licenses\youtube\%(Filename)%(Extension)"
             ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <InternalsVisibleTo Include="AnomalyDonationBridge.AppTests" />
    <Compile Include="..\AnomalyDonationBridge.CrashGuard\Watchdog.cs" Link="Services\Watchdog.cs" />
    <ProjectReference Include="..\AnomalyDonationBridge.CrashGuard\AnomalyDonationBridge.CrashGuard.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\AnomalyDonationBridge.Core\AnomalyDonationBridge.Core.csproj" />
    <ProjectReference Include="..\AnomalyDonationBridge.Persistence\AnomalyDonationBridge.Persistence.csproj" />
    <ProjectReference Include="..\AnomalyDonationBridge.DonationAlerts\AnomalyDonationBridge.DonationAlerts.csproj" />
    <ProjectReference Include="..\AnomalyDonationBridge.DonateX\AnomalyDonationBridge.DonateX.csproj" />
    <ProjectReference Include="..\AnomalyDonationBridge.YouTubeChat\AnomalyDonationBridge.YouTubeChat.csproj" />
    <ProjectReference Include="..\AnomalyDonationBridge.GameIpc\AnomalyDonationBridge.GameIpc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\AnomalyDonationBridge.ico" />
    <Resource Include="Assets\AnomalyDonationBridge.Paused.ico" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\third-party\roulette\*"
             Link="_internal\licenses\roulette\%(Filename)%(Extension)"
             ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\game-addon\gamedata\configs\ui\anomaly_donation_bridge_voting.xml"
             Link="addon-package\gamedata\configs\ui\anomaly_donation_bridge_voting.xml"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
