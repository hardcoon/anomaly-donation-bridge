ADB_PRESET_END]]

function on_game_start()
	local descriptor = anomaly_donation_bridge_effects_direct_spawn.descriptor("npc")
	local ok, reason = anomaly_donation_bridge_registry.register_builtin("spawn_npcs", descriptor)
	if not ok and type(printf) == "function" then
		printf("[ADB] spawn_npcs registration failed: %s", tostring(reason))
	end
end
