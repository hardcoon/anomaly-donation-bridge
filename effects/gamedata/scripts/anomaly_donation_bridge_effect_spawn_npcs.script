--[[ADB_PRESET_V1
{
  "schemaVersion": 1,
  "handlerId": "spawn_npcs",
  "displayName": "Заспавнить NPC",
  "description": "Создаёт выбранных NPC из свежего безопасного каталога установленной игры.",
  "category": "npc_mutants",
  "cooldownSeconds": 3,
  "parameterDefinitions": [
    {
      "key": "section_id",
      "displayName": "NPC",
      "kind": "Choice",
      "catalogKind": "Npc",
      "defaultValue": ""
    },
    {
      "key": "count",
      "displayName": "Количество",
      "kind": "Integer",
      "minimum": 1,
      "maximum": 99,
      "defaultValue": "1"
    },
    {
      "key": "random_group",
      "displayName": "Создавать случайную группу из добавленных",
      "kind": "Choice",
      "options": [
        "true",
        "false"
      ],
      "defaultValue": "false"
    },
    {
      "key": "use_donor_name",
      "displayName": "Спавнить NPC с ником донатера",
      "kind": "Choice",
      "options": [
        "true",
        "false"
      ],
      "defaultValue": "false"
    },
    {
      "key": "radius_meters",
      "displayName": "Радиус появления, м",
      "kind": "Integer",
      "minimum": 10,
      "maximum": 500,
      "defaultValue": "25"
    },
    {
      "key": "spawn_point_method",
      "displayName": "Способ поиска места появления",
      "kind": "Choice",
      "options": [
        "boss_sample",
        "legacy",
        "graph",
        "scan",
        "coordinates"
      ],
      "optionLabels": {
        "boss_sample": "Случайные точки локации (рекомендуется)",
        "legacy": "По прямой от игрока",
        "graph": "С обходом препятствий",
        "scan": "Полный поиск по локации",
        "coordinates": "Случайные координаты"
      },
      "defaultValue": "boss_sample"
    }
  ],
  "parameters": {
    "section_id": "",
    "count": "1",
    "random_group": "false",
    "use_donor_name": "false",
    "radius_meters": "25",
    "spawn_point_method": "boss_sample"
